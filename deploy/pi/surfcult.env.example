# Settings for surfcult.service. install.sh copies this to /etc/surfcult/surfcult.env only if that file is missing.
# The installed file is world-readable: put the key in a file (mode 600, owned by patrick), never here.
# Every variable is listed in docs/reference/run.md.
SURFCULT_JELLYFIN_URL=http://10.0.0.200:8096
SURFCULT_JELLYFIN_API_KEY_FILE=/home/patrick/spike/.jf-key
#SURFCULT_JELLYFIN_USER_ID=
# The web admin. Without these it listens on 127.0.0.1:8090 with no token, so
# only the Pi itself can reach it. To use it from a phone on the LAN, set the
# address and a token file (mode 600), never the token itself here.
#SURFCULT_API_ADDR=0.0.0.0:8090
#SURFCULT_API_TOKEN_FILE=/home/patrick/surfcult/.api-token
# Read by the unit's command line.
SURFCULT_CONFIG=/home/patrick/surfcult/channels.toml
SURFCULT_DB=/home/patrick/surfcult/surfcult.db

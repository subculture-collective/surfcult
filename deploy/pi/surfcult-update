#!/usr/bin/env python3
"""Install the newest main build of surfcult from GitHub Actions.

Runs as root from a systemd timer on the Raspberry Pi. It reads a read-only GitHub
token, finds the newest successful push run of the CI workflow on main, downloads
that run's artifact and verifies it. It then installs it under ROOT/releases/<sha>
and points ROOT/current at it. If the service unit exists, it restarts the unit and
rolls back when the unit does not come up.
"""
import fcntl
import hashlib
import io
import os
import re
import shutil
import struct
import subprocess
import sys
import time
import urllib.error
import urllib.request
import zipfile
import json

API = os.environ.get("SURFCULT_API", "https://api.github.com")
REPO = os.environ.get("SURFCULT_REPO", "subculture-collective/surfcult")
WORKFLOW = os.environ.get("SURFCULT_WORKFLOW", "pr-ci.yml")
ARTIFACT = os.environ.get("SURFCULT_ARTIFACT", "surfcult-aarch64")
ROOT = os.environ.get("SURFCULT_ROOT", "/opt/surfcult")
TOKEN_FILE = os.environ.get("SURFCULT_TOKEN_FILE", "/etc/surfcult-updater/token")
UNIT = os.environ.get("SURFCULT_UNIT", "surfcult.service")
SMOKE_USER = os.environ.get("SURFCULT_SMOKE_USER", "nobody")
SETTLE_SECONDS = float(os.environ.get("SURFCULT_SETTLE", "10"))
KEEP = int(os.environ.get("SURFCULT_KEEP", "3"))
MAX_BYTES = 64 * 1024 * 1024
SHA_RE = re.compile(r"^[0-9a-f]{40}$")


class Refused(Exception):
    """The build was found but must not be installed."""


def log(message):
    print(message, flush=True)


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def _request(url, token=None):
    headers = {"Accept": "application/vnd.github+json", "User-Agent": "surfcult-updater",
               "X-GitHub-Api-Version": "2022-11-28"}
    if token:
        headers["Authorization"] = "Bearer " + token
    return urllib.request.Request(url, headers=headers)


def api_json(path, token):
    with urllib.request.urlopen(_request(API + path, token), timeout=30) as response:
        return json.load(response)


def download(url, token):
    """GitHub answers with a redirect to a signed URL. The token must not follow it."""
    opener = urllib.request.build_opener(_NoRedirect)
    try:
        opener.open(_request(url, token), timeout=30)
        raise Refused("expected a redirect from the artifact URL")
    except urllib.error.HTTPError as error:
        if error.code not in (301, 302, 303, 307, 308):
            raise
        location = error.headers.get("Location")
        error.close()
    if not location or not location.startswith("https://") and not location.startswith(API):
        raise Refused("unexpected artifact redirect")
    with urllib.request.urlopen(urllib.request.Request(location, headers={"User-Agent": "surfcult-updater"}),
                                timeout=120) as response:
        data = response.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        raise Refused("artifact is larger than %d bytes" % MAX_BYTES)
    return data


def newest_main_build(token):
    path = "/repos/%s/actions/workflows/%s/runs?branch=main&event=push&status=success&per_page=1" % (REPO, WORKFLOW)
    runs = api_json(path, token).get("workflow_runs", [])
    if not runs:
        return None
    run = runs[0]
    sha = run.get("head_sha", "")
    if not SHA_RE.match(sha):
        raise Refused("run has an invalid commit id")
    if run.get("head_branch") != "main" or run.get("event") != "push" or run.get("conclusion") != "success":
        raise Refused("run is not a successful push to main")
    return run["id"], sha


def artifact_url(token, run_id):
    listing = api_json("/repos/%s/actions/runs/%d/artifacts?name=%s" % (REPO, run_id, ARTIFACT), token)
    for artifact in listing.get("artifacts", []):
        if artifact.get("name") == ARTIFACT and not artifact.get("expired"):
            url = artifact.get("archive_download_url", "")
            if not url.startswith("%s/repos/%s/actions/artifacts/" % (API, REPO)):
                raise Refused("unexpected artifact URL")
            return url
    return None


def unpack(data):
    """Return the binary after checking the archive, checksum and ELF header."""
    with zipfile.ZipFile(io.BytesIO(data)) as archive:
        infos = {info.filename: info for info in archive.infolist()}
        if set(infos) != {"surfcult", "surfcult.sha256"}:
            raise Refused("archive must hold exactly surfcult and surfcult.sha256")
        if sum(info.file_size for info in infos.values()) > MAX_BYTES:
            raise Refused("archive expands past the size limit")
        binary = archive.read("surfcult")
        listed = archive.read("surfcult.sha256").decode("ascii", "replace").split()
    if not listed or listed[0] != hashlib.sha256(binary).hexdigest():
        raise Refused("checksum does not match")
    # 64-bit (class 2), little-endian, machine 0xB7 = aarch64.
    if len(binary) < 20 or binary[:4] != b"\x7fELF" or binary[4] != 2 or binary[5] != 1 \
            or struct.unpack_from("<H", binary, 18)[0] != 0xB7:
        raise Refused("not an aarch64 ELF executable")
    return binary


def smoke(path):
    """Run the new binary once as an unprivileged user. It prints its usage when given no arguments."""
    command = [path]
    if SMOKE_USER:
        command = ["runuser", "-u", SMOKE_USER, "--"] + command
    try:
        result = subprocess.run(command, capture_output=True, timeout=15, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return False
    return b"surfcult" in (result.stdout + result.stderr).lower()


def systemctl(*args):
    return subprocess.run(["systemctl", *args], capture_output=True, text=True)


def restart_service():
    """True when there is no unit, or the unit is active after a restart."""
    if systemctl("cat", UNIT).returncode != 0:
        log("no %s unit; installed without restarting anything" % UNIT)
        return True
    systemctl("restart", UNIT)
    time.sleep(SETTLE_SECONDS)
    return systemctl("is-active", UNIT).stdout.strip() == "active"


def point(link_name, target):
    link = os.path.join(ROOT, link_name)
    temp = link + ".new"
    if os.path.lexists(temp):
        os.remove(temp)
    os.symlink(target, temp)
    os.replace(temp, link)


def current_release():
    try:
        return os.path.basename(os.readlink(os.path.join(ROOT, "current")))
    except OSError:
        return None


def failed_builds():
    try:
        with open(os.path.join(ROOT, "failed")) as handle:
            return set(handle.read().split())
    except OSError:
        return set()


def prune():
    releases = os.path.join(ROOT, "releases")
    keep_names = {current_release()}
    try:
        keep_names.add(os.path.basename(os.readlink(os.path.join(ROOT, "previous"))))
    except OSError:
        pass
    ordered = sorted((entry for entry in os.listdir(releases) if SHA_RE.match(entry)),
                     key=lambda name: os.path.getmtime(os.path.join(releases, name)), reverse=True)
    for name in ordered[KEEP:]:
        if name not in keep_names:
            shutil.rmtree(os.path.join(releases, name))
            log("removed old release " + name[:12])


def install(sha, binary):
    releases = os.path.join(ROOT, "releases")
    final = os.path.join(releases, sha)
    staging = final + ".partial"
    shutil.rmtree(staging, ignore_errors=True)
    os.makedirs(staging, mode=0o755)
    os.chmod(staging, 0o755)
    path = os.path.join(staging, "surfcult")
    with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o755), "wb") as handle:
        handle.write(binary)
    if not smoke(path):
        shutil.rmtree(staging, ignore_errors=True)
        raise Refused("the new binary failed its smoke test")
    shutil.rmtree(final, ignore_errors=True)
    os.rename(staging, final)
    previous = current_release()
    if previous:
        point("previous", os.path.join("releases", previous))
    point("current", os.path.join("releases", sha))
    if restart_service():
        return True
    log("service did not become active; rolling back")
    with open(os.path.join(ROOT, "failed"), "a") as handle:
        handle.write(sha + "\n")
    if previous:
        point("current", os.path.join("releases", previous))
        restart_service()
    return False


def main():
    os.makedirs(os.path.join(ROOT, "releases"), exist_ok=True)
    with open(os.path.join(ROOT, ".lock"), "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            log("another update is running")
            return 0
        return update()


def update():
    try:
        with open(TOKEN_FILE) as handle:
            token = handle.read().strip()
        build = newest_main_build(token)
        if build is None:
            log("no successful main build found")
            return 0
        run_id, sha = build
        if sha == current_release():
            log("up to date at " + sha[:12])
            return 0
        if sha in failed_builds():
            log("skipping %s: it failed on this host before" % sha[:12])
            return 0
        url = artifact_url(token, run_id)
        if url is None:
            log("run %d has no unexpired %s artifact" % (run_id, ARTIFACT))
            return 0
        binary = unpack(download(url, token))
        if not install(sha, binary):
            return 1
        log("installed " + sha[:12])
        prune()
        return 0
    except Refused as reason:
        log("refused: %s" % reason)
        return 1
    except (urllib.error.URLError, OSError) as error:
        log("update failed: %s" % error)
        return 1


if __name__ == "__main__":
    sys.exit(main())
